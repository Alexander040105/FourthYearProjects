{
  "database": "juanmart_data_lake",
  "collection": "rawLanding",
  "audit_notes": "Run these native MongoDB aggregation queries against the landing collection before implementing transformation logic.",
  "queries": [
    {
      "name": "landing_document_count",
      "description": "Count the number of documents landed in the collection.",
      "pipeline": [
        {
          "$count": "total_documents"
        }
      ]
    },
    {
      "name": "required_field_presence_audit",
      "description": "Audit whether core top-level fields are present and non-empty.",
      "pipeline": [
        {
          "$project": {
            "source": { "$ifNull": ["$source", ""] },
            "eventType": { "$ifNull": ["$eventType", ""] },
            "payload": { "$ifNull": ["$payload", ""] },
            "ingestedAt": { "$ifNull": ["$ingestedAt", ""] }
          }
        },
        {
          "$group": {
            "_id": null,
            "documents_with_source": {
              "$sum": {
                "$cond": [
                  { "$ne": ["$source", ""] },
                  1,
                  0
                ]
              }
            },
            "documents_with_eventType": {
              "$sum": {
                "$cond": [
                  { "$ne": ["$eventType", ""] },
                  1,
                  0
                ]
              }
            },
            "documents_with_payload": {
              "$sum": {
                "$cond": [
                  { "$ne": ["$payload", ""] },
                  1,
                  0
                ]
              }
            },
            "documents_with_ingestedAt": {
              "$sum": {
                "$cond": [
                  { "$ne": ["$ingestedAt", ""] },
                  1,
                  0
                ]
              }
            },
            "total_documents": { "$sum": 1 }
          }
        }
      ]
    },
    {
      "name": "empty_or_null_value_audit",
      "description": "Find documents with empty strings, nulls, or missing values in key fields.",
      "pipeline": [
        {
          "$match": {
            "$or": [
              { "source": { "$in": [null, ""] } },
              { "eventType": { "$in": [null, ""] } },
              { "payload": { "$in": [null, ""] } }
            ]
          }
        },
        {
          "$project": {
            "_id": 1,
            "source": 1,
            "eventType": 1,
            "payload": 1,
            "ingestedAt": 1
          }
        },
        {
          "$limit": 50
        }
      ]
    },
    {
      "name": "payload_shape_profile",
      "description": "Profile the keys present inside the nested payload object.",
      "pipeline": [
        {
          "$match": {
            "payload": { "$type": "object" }
          }
        },
        {
          "$project": {
            "payload_keys": {
              "$map": {
                "input": { "$objectToArray": "$payload" },
                "as": "entry",
                "in": "$$entry.k"
              }
            }
          }
        },
        {
          "$unwind": "$payload_keys"
        },
        {
          "$group": {
            "_id": "$payload_keys",
            "occurrences": { "$sum": 1 }
          }
        },
        {
          "$sort": { "occurrences": -1 }
        }
      ]
    },
    {
      "name": "ingestion_freshness_profile",
      "description": "Review ingestion timestamps to understand recency and distribution.",
      "pipeline": [
        {
          "$group": {
            "_id": null,
            "latest_ingested_at": { "$max": "$ingestedAt" },
            "earliest_ingested_at": { "$min": "$ingestedAt" },
            "documents_count": { "$sum": 1 }
          }
        }
      ]
    },
    {
      "name": "duplicate_payload_signature_audit",
      "description": "Detect likely duplicate landing records by a normalized payload signature.",
      "pipeline": [
        {
          "$project": {
            "payload_signature": {
              "$concat": [
                { "$ifNull": ["$source", ""] },
                "|",
                { "$ifNull": ["$eventType", ""] },
                "|",
                { "$ifNull": ["$ingestedAt", ""] }
              ]
            },
            "source": 1,
            "eventType": 1
          }
        },
        {
          "$group": {
            "_id": "$payload_signature",
            "count": { "$sum": 1 },
            "sample_documents": {
              "$push": {
                "_id": "$_id",
                "source": "$source",
                "eventType": "$eventType"
              }
            }
          }
        },
        {
          "$match": { "count": { "$gt": 1 } }
        },
        {
          "$sort": { "count": -1 }
        },
        {
          "$limit": 20
        }
      ]
    }
  ]
}
